# Python-generated files
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/

# KaruFile default output directories (root/PDF CLI and standalone image CLI)
*_軽量化/
*_resized/
# Custom --output directories should be added to .git/info/exclude locally.
# Runtime names below apply at any depth: reports can sit outside output trees.

# PDF runtime state, reports, and interrupted report publication
.pdf-shrink/
report.csv
report.dry-run.csv
.report.csv.*.tmp
.report.csv.*.backup
.report.dry-run.csv.*.tmp
.report.dry-run.csv.*.backup

# PDF comparison bundles, manifests, and interrupted manifest publication
# These are runtime outputs, not the versioned diagrams/guide under docs/.
pdf-preview/
pdf-preview.json
pdf-preview.dry-run.json
.pdf-preview.json-*.tmp
.pdf-preview.dry-run.json-*.tmp

# Standalone image reports, including dry-run manifests
*.image-errors.csv
*.image-manifest.csv
*.image-manifest.dry-run.csv
.*.image-errors.csv.*.tmp
.*.image-manifest.csv.*.tmp
.*.image-manifest.dry-run.csv.*.tmp

# Standalone video state and reports, including dry-run reports
*.video-state/
*.video-report.csv
*.video-report.dry-run.csv
.*.video-report.csv.*.tmp
.*.video-report.dry-run.csv.*.tmp

# Excel reports and temporary workspace; source xlsx fixtures stay versioned.
*.excel-report.csv
*.excel-report.dry-run.csv
*.excel-work/
.*.excel-report.csv.*.tmp
.*.excel-report.dry-run.csv.*.tmp

# Keep uv.lock, .python-version, ExecPlans, and architecture/visual-check artifacts.
# Do not ignore media extensions: source fixtures may be versioned.
# Do not add blanket *.json, *.csv, *.html, *.tmp, or docs/ exclusions.

# Windows Explorer-generated files
Thumbs.db
desktop.ini

# Local Devin CLI overrides
.devin/config.local.json
