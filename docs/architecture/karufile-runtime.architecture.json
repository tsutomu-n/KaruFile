  "cards": [
    {
      "dot": "cyan",
      "title": "主要経路",
      "items": [
        "利用者 → karufile.py → orchestrator",
        "PDF、画像、compact動画を順に処理",
        "現在実行の結果を照合して終了コードを返す"
      ]
    },
    {
      "dot": "emerald",
      "title": "入力保護",
      "items": [
        "開始前・終了後に全入力のidentityとSHA-256を照合",
        "危険なpath・link・hardlinkを起動前に拒否",
        "検証済み一時ファイルから正式出力へ公開"
      ]
    },
    {
      "dot": "amber",
      "title": "圧縮設定",
      "items": [
        "PDFは通常300 DPI、写真指定だけ約200 DPI・詳細検証",
        "compact画像は1024x768、動画は720p・30fps・AV1",
        "写真指定は作業ツリー実装。ソースリンクは変更前commit"
      ]
    }
  ]
